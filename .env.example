# ============================================================
# Gamlepappa Smarthus - Hunstein 48c Smart Home Dashboard
# Kopier denne filen til ".env" og fyll inn verdiene dine.
# ============================================================

# --- Homey Pro tilgang -------------------------------------
# Personal Access Token fra https://my.homey.app/me  (klikk "Account" -> "API Keys")
HOMEY_PAT=

# (valgfritt) Cloud-ID til Homey Pro - finnes på samme side under "Homey ID".
# Hvis du lar denne stå tom vil backenden prøve å autodetektere via PAT.
HOMEY_CLOUD_ID=

# --- Lokasjon for værwidget --------------------------------
# Brukes mot met.no Locationforecast API. Standard er Hunstein 48c i Bergen.
HOME_LAT=60.3913
HOME_LON=5.3221
HOME_PLACE=Hunstein 48c

# --- Hjemmenett-monitor (nettverkslag i 3D-huset) --------
# MCP-endepunktet og lese-nøkkelen (HJEMMENETT_READ_TOKEN) fra hjemmenett-monitoren.
# Nøkkelen blir på serveren og sendes aldri til nettleseren.
HJEMMENETT_MCP_URL=https://metadata-receiver-production.up.railway.app/mcp
HJEMMENETT_MCP_TOKEN=

# --- Server -------------------------------------------------
PORT=8080
NODE_ENV=production

# --- Demo-modus --------------------------------------------
# Sett til "true" for å kjøre uten Homey-tilkobling (bruker mock-data).
# Praktisk under utvikling og ved første gangs deploy før PAT er klar.
DEMO_MODE=false

# --- Frontend (client) -------------------------------------
# I produksjon er dette tomt fordi backend serverer frontend på samme origin.
# I dev settes dette automatisk av Vite-proxyen.
VITE_API_BASE=

# Smal nøkkel (min. 32 tegn) som bare kan lese 3D-endringsønskene og merke dem gjort.
# Brukes når Claude lager ny modell. Se docs/ENDRINGSONSKER.md.
HOUSE3D_CHANGES_TOKEN=

# --- Iphone-fanen (iphone-remote) ----------------------------
# Dashboardet logger inn hos iphone-remote på serveren og viser den under /iphone/.
# Brukernavn og passord er ADMIN_USER / ADMIN_PASSWORD i iphone-remote-prosjektet.
IPHONE_REMOTE_URL=https://iphone-remote-production.up.railway.app
IPHONE_REMOTE_USER=
IPHONE_REMOTE_PASSWORD=
